# Backend.AI Docker Compose Configuration
# Copy to .env and customize. All values have sensible defaults.
# Uses upstream halfstack.toml configs with BA_* env overrides.

# Data directory (set to absolute path, e.g. /home/user/.local/share/backendai)
# BA_HOME=/home/user/.local/share/backendai

# Deploy mode: dev (auto-resolve, permissive) or prod (strict)
# BA_MODE=dev

# External hostname (auto-resolved in dev, required in prod)
# BA_ADVERTISED_HOST=192.168.1.100

# Database (default: develove, matching upstream halfstack.toml)
BA_DB_PASSWORD=develove
# BA_DB_PORT=8100
# BA_DB_NAME=backend

# Redis
# BA_REDIS_PORT=8110

# etcd
# BA_ETCD_PORT=8120

# Admin account
BA_ADMIN_EMAIL=admin@example.com
BA_ADMIN_PASSWORD=changeme
