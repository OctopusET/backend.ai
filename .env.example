# Backend.AI Configuration
# Copy to .env and customize
# docker compose reads this file automatically

# Data directory (default: ${XDG_DATA_HOME:-~/.local/share}/backendai)
# BACKENDAI_HOME=/custom/path

# Admin account
BACKENDAI_ADMIN_EMAIL=admin@example.com
BACKENDAI_ADMIN_PASSWORD=changeme

# Database
BACKENDAI_DB_NAME=backend
BACKENDAI_DB_PASSWORD=changeme

# AppProxy
BACKENDAI_APPPROXY_SECRET=changeme
BACKENDAI_APPPROXY_JWT_SECRET=changeme

# Storage Proxy
BACKENDAI_STORAGE_SECRET=changeme
